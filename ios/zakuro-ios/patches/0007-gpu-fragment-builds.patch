+
+impl Fragments {
+    /// the pair of modules a build has, leaving depth to the rasterizer first.
+    fn of(&self, mode: FragmentMode) -> [vk::ShaderModule; 2] {
+        match mode {
+            FragmentMode::Default => [self.plain, self.writing],
+            FragmentMode::Fast => self.fast,
+            FragmentMode::Texonly => self.texonly,
+            FragmentMode::Specialized(_) => self.specialized,
+            FragmentMode::SpecFast(_) => self.spec_fast,
+        }
+    }
+
+    /// the modules of every build, for the device to destroy.
+    fn all(&self) -> [vk::ShaderModule; 10] {
+        [
+            self.plain,
+            self.writing,
+            self.fast[0],
+            self.fast[1],
+            self.texonly[0],
+            self.texonly[1],
+            self.specialized[0],
+            self.specialized[1],
+            self.spec_fast[0],
+            self.spec_fast[1],
+        ]
     }
