+#!/usr/bin/env bash
+# build.sh — rebuild the fragment shaders' SPIR-V with glslangValidator.
+#
+# The Vulkan renderer includes these precompiled (include_bytes! in
+# raster/hardware.rs), so a machine that builds Zakuro needs no glslang. Run
+# this from this directory after changing raster.frag; the .spv files are
+# committed. The default pair (raster.frag.spv, raster_depth.frag.spv) is the
+# one every draw runs unless a diagnostic build is asked for with
+# ZAKURO_FRAG_FAST_MATH, ZAKURO_FRAG_SPECIALIZE or
+# ZAKURO_MEASURE_TEXONLY; the other pairs are those builds (both fragment
+# A/B switches set run the combined pair, without precise and with the
+# specialization constants), see ios/zakuro-ios/README.md.
+#
+# glslangValidator 16.2.0 was used for the committed files:
+#   glslangValidator -V --target-env vulkan1.3 -S frag raster.frag -o out.spv
+#
+# Usage: GLSLANG=/path/to/glslangValidator ./build.sh
+set -euo pipefail
+cd "$(dirname "$0")"
+GLSLANG="${GLSLANG:-glslangValidator}"
+build() {
+  local out="$1"
+  shift
+  printf "%-30s %s\n" "$out" "$*"
+  # shellcheck disable=SC2086
+  "$GLSLANG" -V --target-env vulkan1.3 -S frag "$@" raster.frag -o "$out"
+}
+build raster.frag.spv
+build raster_depth.frag.spv -DWRITES_DEPTH
+build raster_fast.frag.spv -DZAKURO_FAST_MATH
+build raster_depth_fast.frag.spv -DZAKURO_FAST_MATH -DWRITES_DEPTH
+build raster_texonly.frag.spv -DZAKURO_MEASURE_TEXONLY
+build raster_depth_texonly.frag.spv -DZAKURO_MEASURE_TEXONLY -DWRITES_DEPTH
+build raster_spec.frag.spv -DZAKURO_FRAG_SPECIALIZE
+build raster_depth_spec.frag.spv -DZAKURO_FRAG_SPECIALIZE -DWRITES_DEPTH
+build raster_spec_fast.frag.spv -DZAKURO_FRAG_SPECIALIZE -DZAKURO_FAST_MATH
+build raster_depth_spec_fast.frag.spv -DZAKURO_FRAG_SPECIALIZE -DZAKURO_FAST_MATH -DWRITES_DEPTH
