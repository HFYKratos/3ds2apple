+/// the kinds of work the GPU's timestamps tell apart, in the order
+/// [`GpuTimes::milliseconds`] has them.
+#[cfg(feature = "vulkan")]
+pub const GPU_WORK: [&str; 9] = ["other", "draw", "upload", "clear", "transfer", "capture", "copy", "download", "barrier"];
+
+/// the GPU's own time, from the timestamps it writes as the work changes
+/// kind, `ZAKURO_GPU_TIMES=1` turns it on. Cumulative since the renderer
+/// started: a host that reports a window subtracts two readings.
+#[cfg(feature = "vulkan")]
+#[derive(Clone, Copy, Debug, Default)]
+pub struct GpuTimes {
+    /// batches the GPU finished and whose timestamps were read.
+    pub batches: u64,
+    /// milliseconds the GPU spent per kind of work, see [`GPU_WORK`].
+    pub milliseconds: [f64; 9],
+    /// draws and render passes the batches recorded, and the barriers between
+    /// them.
+    pub draws: u64,
+    pub renderings: u64,
+    pub barriers: u64,
+    /// milliseconds the host waited for the GPU and how many times: for room
+    /// to record the next batch in, then for work it needed done.
+    pub waited_room_ms: f64,
+    pub waited_room_count: u64,
+    pub waited_done_ms: f64,
+    pub waited_done_count: u64,
+    /// vertices, primitives past clipping, fragments and compute invocations
+    /// the batches shaded, when the device keeps pipeline statistics;
+    /// pipeline_statistics says whether they mean anything.
+    pub shaded: [u64; 4],
+    pub pipeline_statistics: bool,
+}
+
+#[cfg(feature = "vulkan")]
+impl GpuTimes {
+    /// the milliseconds per kind of work between an earlier reading and this
+    /// one.
+    pub fn since(&self, earlier: &GpuTimes) -> [f64; 9] {
+        std::array::from_fn(|i| (self.milliseconds[i] - earlier.milliseconds[i]).max(0.0))
+    }
+
+    /// what this reading adds up to over an earlier one.
+    pub fn added_milliseconds(&self, earlier: &GpuTimes) -> f64 {
+        self.since(earlier).iter().sum()
+    }
+}
