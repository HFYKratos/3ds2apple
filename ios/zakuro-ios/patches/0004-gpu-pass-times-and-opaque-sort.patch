+    /// alpha test, logic op or stencil change, and the vertices placed on the
+    /// CPU so their depth is known. Everything else keeps the title's order.
+    fn hold_back(&mut self, recorded: &Recorded, geometry: &Geometry<'_>, registers: &[u32], color_mask: u32) -> bool {
+        if !sort_opaque() || self.twins || self.rendering.is_none() {
+            return false;
+        }
+        // the depth test has to accept exactly what is nearer the viewer: with
+        // depth writes on, LESS and LEQUAL make the picture the same whatever
+        // the order, and anything else (ALWAYS, GREATER, EQUAL, ...) makes the
+        // draw's place in the order matter
