+/// the pixels a draw the CPU placed estimates to cover: the area of its
+/// triangles in window pixels, added up whether they overlap or not, which is
+/// what the GPU shades. The estimate is for attribution, not for a picture:
+/// it ignores the scissor and what the depth or stencil test would drop.
+#[cfg(feature = "vulkan")]
+pub(super) fn estimated_pixels(vertices: &[Screen], indices: &[u32]) -> u64 {
+    let mut area = 0.0f64;
+    for triangle in indices.chunks_exact(3) {
+        let at = |i: usize| &vertices[i as usize];
+        let [a, b, c] = [at(triangle[0] as usize), at(triangle[1] as usize), at(triangle[2] as usize)];
+        let cross = (b.x - a.x) as f64 * (c.y - a.y) as f64 - (c.x - a.x) as f64 * (b.y - a.y) as f64;
+        area += cross.abs() * 0.5;
+    }
+    area as u64
+}
