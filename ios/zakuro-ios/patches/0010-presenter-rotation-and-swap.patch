diff --git a/crates/zakuro-gpu/src/backend/mod.rs b/crates/zakuro-gpu/src/backend/mod.rs
index 1a4770e..ecc5b20 100644
--- a/crates/zakuro-gpu/src/backend/mod.rs
+++ b/crates/zakuro-gpu/src/backend/mod.rs
@@ -374,6 +374,18 @@ pub enum Shown {
     Both,
 }
 
+impl Shown {
+    /// the picture drawn into the same place once the app asks for the two
+    /// screens to trade places; the eyes' own pictures stay as they are
+    pub fn swapped(self) -> Shown {
+        match self {
+            Shown::Top => Shown::Bottom,
+            Shown::Bottom => Shown::Top,
+            right => right,
+        }
+    }
+}
+
 /// the screens a frame draws, where and from which picture
 /// the 3D shows when the title drew a picture for the right eye,
 /// side by side shows the left one's twice otherwise so a 3D TV keeps its halves
@@ -469,6 +481,14 @@ pub trait Presenter {
     /// custom places keeps the arrangement's own
     fn set_custom_viewports(&mut self, _custom: CustomViewports) {}
 
+    /// how the custom layout turns each screen's picture inside its place, from
+    /// the next frame on; north is upright and the default
+    fn set_custom_rotation(&mut self, _rotation: ScreenOrientation) {}
+
+    /// swaps which screen's picture each place draws, from the next frame on;
+    /// the places stay put, so presets look exactly as before while this is off
+    fn set_screen_swap(&mut self, _swap: bool) {}
+
     /// sets the orientation of both screens
     fn set_orientation(&mut self, orientation: ScreenOrientation);
 
@@ -793,4 +813,36 @@ mod tests {
         assert_eq!(top.unwrap().width, 1200.0);
         assert_eq!((bottom.unwrap().width, bottom.unwrap().height), (320.0, 240.0));
     }
+
+    /// swapping screens trades the pictures drawn in the places, not the places
+    #[test]
+    fn swapping_screens_trades_the_pictures() {
+        assert_eq!(Shown::Top.swapped(), Shown::Bottom);
+        assert_eq!(Shown::Bottom.swapped(), Shown::Top);
+        // the right eye's own pictures don't swap (the console's 3D is the top screen)
+        assert_eq!(Shown::Right.swapped(), Shown::Right);
+        assert_eq!(Shown::Both.swapped(), Shown::Both);
+
+        // a preset's places stay exactly where they are, w/ only the pictures trading
+        let off = place(400, 480, ScreenLayout::Stacked, ScreenOrientation::North, TOP_WIDTH, false, Stereo { mode: StereoMode::Off, swap: false }, true);
+        let on: Vec<_> = off.iter().map(|(viewport, shown)| (*viewport, shown.swapped())).collect();
+        let shown = |places: &[(Viewport, Shown)]| places.iter().map(|(_, shown)| *shown).collect::<Vec<_>>();
+        let bounds = |places: &[(Viewport, Shown)]| places.iter().map(|(viewport, _)| *viewport).collect::<Vec<_>>();
+        assert_eq!(shown(&off), [Shown::Top, Shown::Bottom]);
+        assert_eq!(shown(&on), [Shown::Bottom, Shown::Top]);
+        assert_eq!(bounds(&off), bounds(&on));
+    }
+
+    /// the custom layout's rotation is the same clockwise quarter turns as the presets
+    #[test]
+    fn the_custom_rotation_turns_the_picture_clockwise() {
+        for (rotation, degrees) in [
+            (ScreenOrientation::North, 0),
+            (ScreenOrientation::East, 90),
+            (ScreenOrientation::South, 180),
+            (ScreenOrientation::West, 270),
+        ] {
+            assert_eq!(rotation.clockwise_angle(), degrees, "{rotation:?}");
+        }
+    }
 }
