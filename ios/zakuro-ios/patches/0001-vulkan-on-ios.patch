     }
+    #[cfg(target_os = "ios")]
+    for path in IOS_LIBRARIES {
+        // SAFETY: as above, a Vulkan library at a path of its own
+        if let Ok(entry) = unsafe { ash::Entry::load_from(path) } {
+            return Ok(entry);
+        }
+    }
     Err(error)
 }
 
