+/// `ZAKURO_VULKAN_LIBRARY` names another path first.
+#[cfg(target_os = "ios")]
+const IOS_LIBRARIES: [&str; 2] = [
+    "@executable_path/Frameworks/MoltenVK.framework/MoltenVK",
+    "@rpath/libMoltenVK.dylib",
+];
+
