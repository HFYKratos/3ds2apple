+        actual: (Option<(f32, f32, f32, f32)>, Option<(f32, f32, f32, f32)>),
+        expected: (Option<(f32, f32, f32, f32)>, Option<(f32, f32, f32, f32)>),
+    ) -> bool {
+        let screen = |actual: Option<(f32, f32, f32, f32)>, expected: Option<(f32, f32, f32, f32)>| {
+            match (actual, expected) {
+                (None, None) => true,
+                (Some(actual), Some(expected)) => close(actual, expected),
+                _ => false,
+            }
+        };
+        screen(actual.0, expected.0) && screen(actual.1, expected.1)
+    }
