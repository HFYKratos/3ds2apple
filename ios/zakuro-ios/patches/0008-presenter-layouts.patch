+    fn close(actual: (f32, f32, f32, f32), expected: (f32, f32, f32, f32)) -> bool {
+        let near = |a: f32, b: f32| (a - b).abs() < 0.01;
+        near(actual.0, expected.0) && near(actual.1, expected.1) && near(actual.2, expected.2) && near(actual.3, expected.3)
+    }
