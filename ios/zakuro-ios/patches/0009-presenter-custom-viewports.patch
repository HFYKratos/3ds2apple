+/// where the custom layout puts the two screens: rectangles in normalised
+/// drawable pixels, `[left, top, width, height]` from the top left corner
+#[derive(Debug, Clone, Copy, PartialEq, Default)]
+pub struct CustomViewports {
+    /// the upper screen's rectangle
+    pub top: [f32; 4],
+    /// the lower screen's rectangle
+    pub bottom: [f32; 4],
+}
+
+/// places the two screens of the custom layout, the app's normalised rectangles
+/// scaled to the window; a rectangle w/ no size has no place
+pub fn place_custom(window_width: u32, window_height: u32, custom: CustomViewports) -> Vec<(Viewport, Shown)> {
+    let (window_width, window_height) = (window_width as f32, window_height as f32);
+    let place = |rect: [f32; 4], shown: Shown| {
+        let [x, y, width, height] = rect;
+        (width > 0.0 && height > 0.0).then(|| {
+            (Viewport { x: x * window_width, y: y * window_height, width: width * window_width, height: height * window_height }, shown)
+        })
+    };
+    place(custom.top, Shown::Top).into_iter().chain(place(custom.bottom, Shown::Bottom)).collect()
+}
+
