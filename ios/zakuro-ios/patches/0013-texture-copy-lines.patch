+    /// a capture copy names the whole contiguous block as one input line and the
+    /// destination's tile rows as the output lines: the input reads straight through
+    #[test]
+    fn texture_copy_reads_a_contiguous_input_straight_through() {
+        let (input_base, output_base) = (0x1000u32, 0x10000u32);
+        let (tile_row, gap, rows) = (3840u32, 256u32, 50u32);
+        let size = tile_row * rows;
+        let mut memory = FlatMemory(vec![0; 0x80000]);
+        for i in 0..size as usize {
+            memory.0[input_base as usize + i] = (i % 251) as u8;
+        }
+        let mut gpu = Gpu::new();
+        // one input line of the whole block, output lines of a tile row and a gap
+        let input_gap = size / 16;
+        let output_gap = ((gap / 16) << 16) | (tile_row / 16);
+        gpu.texture_copy(&mut memory, input_base, output_base, size, input_gap, output_gap);
+        for row in 0..rows {
+            let from = input_base as usize + (row * tile_row) as usize;
+            let to = output_base as usize + (row * (tile_row + gap)) as usize;
+            assert_eq!(
+                &memory.0[to..to + tile_row as usize],
+                &memory.0[from..from + tile_row as usize],
+                "tile row {row}"
+            );
+        }
+    }
+
+    /// a crop copy still copies each line and skips both gaps, as it always has
+    #[test]
+    fn texture_copy_skips_both_gaps_between_lines() {
+        let (input_base, output_base) = (0x1000u32, 0x10000u32);
+        let (line, gap, lines) = (192u32, 64u32, 4u32);
+        let size = line * lines;
+        let mut memory = FlatMemory(vec![0; 0x40000]);
+        for i in 0..size as usize {
+            memory.0[input_base as usize + i] = (i % 253) as u8;
+        }
+        let mut gpu = Gpu::new();
+        let input_gap = ((gap / 16) << 16) | (line / 16);
+        let output_gap = ((gap / 16) << 16) | (line / 16);
+        gpu.texture_copy(&mut memory, input_base, output_base, size, input_gap, output_gap);
+        for row in 0..lines {
+            let from = input_base as usize + (row * (line + gap)) as usize;
+            let to = output_base as usize + (row * (line + gap)) as usize;
+            assert_eq!(
+                &memory.0[to..to + line as usize],
+                &memory.0[from..from + line as usize],
+                "line {row}"
+            );
+        }
+    }
