<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ThreeDsTwoApple.Launcher.App.Views.MainWindow"
        Title="{Binding WindowTitle}"
        Width="1120" Height="820"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Top bar: app identity, exactly two primary sections (Library / Deploy), Settings gear. -->
    <Border Grid.Row="0" Padding="20,14" Background="{DynamicResource AppSurfaceBrush}">
      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Image Source="/Assets/game-placeholder.png" Width="34" Height="34" />
          <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock Text="{Binding L.AppTitle}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="{Binding WindowTitle}" FontSize="11" Classes="caption" />
          </StackPanel>
        </StackPanel>
        <!-- Centered relative to the whole window (not squeezed between the identity block and the gear). -->
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Classes="nav" Command="{Binding ShowLibraryCommand}">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding L.NavLibrary}" FontSize="14" HorizontalAlignment="Center" />
              <Border Height="2" CornerRadius="1" Background="{DynamicResource AppAccentBrush}" IsVisible="{Binding IsLibrarySection}" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Command="{Binding ShowDeployCommand}">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding L.NavDeploy}" FontSize="14" HorizontalAlignment="Center" />
              <Border Height="2" CornerRadius="1" Background="{DynamicResource AppAccentBrush}" IsVisible="{Binding IsDeploySection}" />
            </StackPanel>
          </Button>
        </StackPanel>
        <Button Classes="gear" Content="⚙" ToolTip.Tip="{Binding L.NavSettings}"
                Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Content -->
    <Grid Grid.Row="1" Margin="20,16,20,8">
      <!-- 1. Library: import / list / remove. No build-install-push actions here. -->
      <ScrollViewer IsVisible="{Binding IsLibrarySection}">
        <StackPanel Spacing="14" MaxWidth="1060" HorizontalAlignment="Stretch">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding L.LibraryTitle}" Classes="h1" />
            <TextBlock Text="{Binding L.LibrarySubtitle}" Classes="muted" MaxWidth="820" HorizontalAlignment="Left" />
          </StackPanel>

          <!-- Exactly one import action: opens the file picker and imports the selected ROM(s).
               No path box, no name override, no explanatory card. Imported games render below. -->
          <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
            <Button Content="{Binding L.LibraryImportAction}" Click="BrowseRomClicked" Classes="primary" />
            <ProgressBar Width="260" Value="{Binding ProgressValue}" IsVisible="{Binding IsImportRunning}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding GameCountText}" Classes="caption" VerticalAlignment="Center" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Games}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="card" Width="330" Margin="0,0,14,14">
                  <Grid RowDefinitions="Auto,*,Auto">
                    <Grid ColumnDefinitions="Auto,*">
                      <!-- ROM icon extracted from the SMDH (cover.png); placeholder when the ROM has no icon.
                           The display name is read-only: it comes from the ROM's localized titles, never user input. -->
                      <Panel Width="52" Height="52" VerticalAlignment="Top">
                        <Image Source="/Assets/game-placeholder.png" Width="52" Height="52" IsVisible="{Binding !HasCover}" />
                        <Image Source="{Binding CoverImage}" Width="52" Height="52" IsVisible="{Binding HasCover}" />
                      </Panel>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PublisherLine}" Classes="caption" IsVisible="{Binding HasPublisher}" TextTrimming="CharacterEllipsis" />
                        <Border Classes="badge" HorizontalAlignment="Left">
                          <TextBlock Text="{Binding StateLabel}" FontSize="11" />
                        </Border>
                      </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="4">
                      <TextBlock Text="{Binding PackLine}" FontSize="12" Foreground="{DynamicResource AppAccentBrush}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding TitleIdLine}" Classes="caption" />
                      <TextBlock Text="{Binding RomLine}" Classes="caption" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
                      <Button Content="{Binding RemoveLabel}" Command="{Binding RemoveCommand}" Classes="ghost" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>

      <!-- 2. Deploy: select one or many games -> one chained action with visible steps. -->
      <ScrollViewer IsVisible="{Binding IsDeploySection}">
        <StackPanel Spacing="14" MaxWidth="1060" HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding L.DeployTitle}" Classes="h1" />
              <TextBlock Text="{Binding L.DeploySubtitle}" Classes="muted" MaxWidth="820" HorizontalAlignment="Left" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Right">
              <TextBlock Text="{Binding DeployStateLabel}" Classes="caption" HorizontalAlignment="Right" />
              <TextBlock Text="{Binding DeploySelectedCountText}" Classes="caption" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>

          <!-- Prerequisites: one row = one status light (green = ready, red = not yet) plus a
               one-line fix hint for red rows. Refresh status re-probes everything including the
               phone; Open Impactor covers the Apple-ID login the launcher cannot detect. -->
          <Border Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding L.DeployPrereqTitle}" Classes="h2" />
                  <TextBlock Text="{Binding DeployPrereqSummary}" Classes="caption" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Content="{Binding L.DeployPrereqRefresh}" Command="{Binding RefreshPrerequisitesCommand}" Classes="ghost" />
                  <Button Content="{Binding L.SettingsAppleOpen}" Command="{Binding OpenImpactorCommand}" Classes="ghost" />
                </StackPanel>
              </Grid>
              <ItemsControl ItemsSource="{Binding DeployPrerequisites}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*" Margin="0,5">
                      <Panel Width="10" Height="10" VerticalAlignment="Top" Margin="0,4,0,0">
                        <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource AppReadyBrush}" IsVisible="{Binding IsReady}" />
                        <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource AppErrorBrush}" IsVisible="{Binding !IsReady}" />
                      </Panel>
                      <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                        <TextBlock Text="{Binding Line}" FontSize="13" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Hint}" Classes="caption" IsVisible="{Binding ShowRedHint}" Foreground="{DynamicResource AppWarningBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Note}" Classes="caption" IsVisible="{Binding ShowNote}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding L.DeployGamesTitle}" Classes="h2" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Content="{Binding L.DeploySelectAll}" Command="{Binding SelectAllCommand}" Classes="ghost" />
                  <Button Content="{Binding L.DeploySelectNone}" Command="{Binding SelectNoneCommand}" Classes="ghost" />
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding L.DeployNoGames}" Classes="muted" IsVisible="{Binding IsDeployEmpty}" />
              <ItemsControl ItemsSource="{Binding DeployGames}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="badge" Margin="0,2" Padding="10,8" HorizontalAlignment="Stretch">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="2" Margin="6,0,0,0">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                          <TextBlock Text="{Binding DetailLine}" Classes="caption" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding StateLabel}" Classes="caption" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- One-click action + Retry. -->
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="{Binding L.DeployAction}" Command="{Binding DeployCommand}" Classes="primary" IsVisible="{Binding !IsDeployFailed}" />
            <Button Content="{Binding L.DeployRetry}" Command="{Binding DeployCommand}" Classes="primary" IsVisible="{Binding IsDeployFailed}" />
            <ProgressBar Width="320" Height="8" Value="{Binding ProgressValue}" IsVisible="{Binding IsDeployRunning}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Step list with per-step state. -->
          <Border Classes="card">
            <StackPanel Spacing="8">
              <ItemsControl ItemsSource="{Binding DeploySteps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5">
                      <TextBlock Text="{Binding Label}" MinWidth="170" FontWeight="SemiBold" VerticalAlignment="Top" />
                      <StackPanel Grid.Column="1" Spacing="1" Margin="8,0,8,0">
                        <TextBlock Text="{Binding Detail}" Classes="caption" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" Classes="caption" VerticalAlignment="Top" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <!-- Idle / done / failed banners. -->
          <Border Classes="card" IsVisible="{Binding IsDeployIdle}">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding L.DeployIdleTitle}" Classes="h2" />
              <TextBlock Text="{Binding L.DeployIdleBody}" Classes="muted" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding IsDeployDone}">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding L.DeployDoneTitle}" Classes="h2" Foreground="{DynamicResource AppAccentBrush}" />
              <TextBlock Text="{Binding L.DeployDoneBody}" Classes="muted" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding IsDeployFailed}">
            <StackPanel Spacing="6">
              <TextBlock Text="{Binding DeployErrorTitle}" Classes="h2" Foreground="{DynamicResource AppWarningBrush}" />
              <TextBlock Text="{Binding DeployErrorDetail}" Classes="muted" />
              <TextBlock Text="{Binding DeployErrorFix}" Classes="caption" />
              <TextBlock Text="{Binding DeployStepName}" Classes="caption" />
              <TextBlock Text="{Binding L.DeployFailedHelp}" Classes="caption" />
            </StackPanel>
          </Border>

          <Button Content="{Binding DeployLogToggleLabel}" Command="{Binding ToggleDeployLogCommand}" Classes="ghost" HorizontalAlignment="Left" />
          <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" Height="200" IsVisible="{Binding ShowDeployLog}"
                   FontFamily="Consolas, Menlo, monospace" FontSize="11" />
        </StackPanel>
      </ScrollViewer>

      <!-- Settings (gear only, minimal: language / Apple ID / device / logs / about). -->
      <ScrollViewer IsVisible="{Binding ShowSettings}">
        <StackPanel Spacing="14" MaxWidth="1060" HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Text="{Binding L.SettingsTitle}" Classes="h1" />
              <TextBlock Text="{Binding L.SettingsVersion}" Classes="caption" />
            </StackPanel>
            <Button Grid.Column="1" Content="✕" Classes="gear" Command="{Binding CloseSettingsCommand}"
                    ToolTip.Tip="{Binding L.SettingsClose}" VerticalAlignment="Top" />
          </Grid>
          <Grid ColumnDefinitions="*,16,*">
            <StackPanel Spacing="12">
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding L.SettingsAppleTitle}" Classes="h2" />
                  <TextBlock Text="{Binding L.SettingsAppleBody}" Classes="muted" />
                  <TextBlock Text="{Binding InstalledBundleIdLine}" Classes="caption" />
                  <TextBlock Text="{Binding ShellStatus}" Classes="caption" />
                  <Button Content="{Binding L.SettingsAppleOpen}" Command="{Binding OpenImpactorCommand}" Classes="ghost" HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding L.AppImpactorNote}" Classes="caption" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding L.SettingsDeviceTitle}" Classes="h2" />
                  <TextBlock Text="{Binding DeviceStatus}" Classes="muted" />
                  <Button Content="{Binding L.DeviceRefresh}" Command="{Binding RefreshDevicesCommand}" Classes="ghost" HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding L.DevicePrereqUsb}" Classes="caption" />
                  <TextBlock Text="{Binding L.DevicePrereqTrust}" Classes="caption" />
                  <TextBlock Text="{Binding L.DevicePrereqUnlock}" Classes="caption" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="12">
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding L.SettingsLanguageTitle}" Classes="h2" />
                  <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{Binding L.SettingsLanguageBody}" Classes="caption" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding L.SettingsLogsTitle}" Classes="h2" />
                  <TextBlock Text="{Binding CurrentLogPath}" Classes="caption" />
                  <!-- Chosen portable (or fallback) folders and the reason, for bug reports. -->
                  <TextBlock Text="{Binding WorkspaceInfoLine}" Classes="caption" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding DistributionInfoLine}" Classes="caption" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding L.SettingsLogsWorkspace}" Command="{Binding OpenWorkspaceCommand}" Classes="ghost" />
                    <Button Content="{Binding L.SettingsLogsExport}" Command="{Binding ExportLogCommand}" Classes="ghost" />
                  </StackPanel>
                  <Button Content="{Binding DiagnosticsToggleLabel}" Command="{Binding ToggleDiagnosticsCommand}" Classes="ghost" HorizontalAlignment="Left" />
                  <ListBox x:Name="DiagnosticsLogList" ItemsSource="{Binding LogLines}" Height="180" IsVisible="{Binding ShowDiagnostics}"
                           FontFamily="Consolas, Menlo, monospace" FontSize="11" />
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding L.SettingsAboutTitle}" Classes="h2" />
                  <TextBlock Text="{Binding L.SettingsAboutBody}" Classes="caption" />
                  <TextBlock Text="{Binding L.ReadinessTitle}" Classes="caption" />
                  <ItemsControl ItemsSource="{Binding Tools}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                          <TextBlock Text="{Binding Name}" FontSize="11" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="1" Text="{Binding StateLabel}" FontSize="11" Classes="caption" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Padding="20,10" Background="{DynamicResource AppSurfaceBrush}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <!-- Automatic startup self-check: green = ready, red = something is missing.
               Hover shows the per-component details; clicking reruns the check. -->
          <Button Classes="readiness" Command="{Binding RefreshReadinessCommand}" ToolTip.Tip="{Binding ReadinessDetail}">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
              <Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource AppReadyBrush}" IsVisible="{Binding IsReadinessReady}" VerticalAlignment="Center" />
              <Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource AppErrorBrush}" IsVisible="{Binding IsReadinessFailed}" VerticalAlignment="Center" />
              <Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource AppWarningBrush}" IsVisible="{Binding IsReadinessChecking}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ReadinessLabel}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <ProgressBar Width="220" Height="6" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
