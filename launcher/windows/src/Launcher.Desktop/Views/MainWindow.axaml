<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ThreeDsTwoApple.Launcher.App.Views.MainWindow"
        Title="3ds2apple Launcher (Windows)"
        Width="1180" Height="820"
        MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#15171C">
  <DockPanel Margin="14">
    <Border DockPanel.Dock="Top" Padding="12" CornerRadius="8" Background="#1E222A">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Header}" FontSize="18" FontWeight="SemiBold" Foreground="#F2E9D8" />
          <TextBlock Text="{Binding ReadinessSummary}" FontSize="12" Foreground="#9BA3B4" TextWrapping="Wrap" />
          <TextBlock Text="Bring your own decrypted ROMs. This tool never downloads games, keys or Apple credentials." FontSize="11" Foreground="#6E7686" />
        </StackPanel>
        <Button Grid.Column="1" Content="Refresh status" Command="{Binding RefreshStatusCommand}" VerticalAlignment="Center" Padding="14,8" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Height="196" Margin="0,10,0,0" Padding="10" CornerRadius="8" Background="#1E222A">
      <Grid RowDefinitions="Auto,8,*">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding StatusText}" Foreground="#D8DEE9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <ProgressBar Grid.Column="1" Width="240" Height="10" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" />
        </Grid>
        <ListBox Grid.Row="2" x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Consolas, Menlo, monospace" FontSize="12" Background="#12141A" />
      </Grid>
    </Border>

    <TabControl Margin="0,10,0,0">
      <TabItem Header="Library &amp; Import">
        <Grid ColumnDefinitions="340,12,*" Margin="8">
          <StackPanel Spacing="8">
            <TextBlock Text="1. Import a decrypted ROM you own" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text=".3ds / .cci (also .ncch / .cxi). The launcher reads headers only; the ROM never leaves this PC."
                       TextWrapping="Wrap" FontSize="12" Foreground="#9BA3B4" />
            <TextBlock Text="ROM path" FontSize="12" Foreground="#9BA3B4" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Text="{Binding ImportPath}" PlaceholderText="D:/ROM/Pokemon Y.cci" />
              <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="BrowseRomClicked" />
            </Grid>
            <TextBlock Text="Display name override (optional, single ROM)" FontSize="12" Foreground="#9BA3B4" />
            <TextBox Text="{Binding DisplayNameOverride}" PlaceholderText="Pokemon Y" />
            <Button Content="Import ROM" Command="{Binding ImportCommand}" HorizontalAlignment="Stretch" Padding="0,10" />
            <Border Padding="10" CornerRadius="6" Background="#1E222A">
              <StackPanel Spacing="4">
                <TextBlock Text="What happens next" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="2. Build the GamePack on your macOS host (real AOT code)." FontSize="12" Foreground="#9BA3B4" TextWrapping="Wrap" />
                <TextBlock Text="3. Install/update the app: packs + GameCatalog are injected into the ROM-free shell IPA and the whole IPA is signed with the official Impactor." FontSize="12" Foreground="#9BA3B4" TextWrapping="Wrap" />
                <TextBlock Text="4. Push this game's ROM + GameInfo into the phone's Documents folder." FontSize="12" Foreground="#9BA3B4" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Button Content="Remove selected from library" Command="{Binding RemoveGameCommand}" />
          </StackPanel>

          <Grid Grid.Column="2" RowDefinitions="Auto,8,*">
            <TextBlock Text="{Binding SelectedSummary}" TextWrapping="Wrap" FontSize="12" Foreground="#C8CFDB" />
            <ListBox Grid.Row="2" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" Background="#181B21">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="2">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" />
                      <TextBlock Text="{Binding TitleID}" FontSize="12" Foreground="#9BA3B4" />
                      <TextBlock Text="{Binding RomPath}" FontSize="11" Foreground="#6E7686" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding PackDescription}" FontSize="11" Foreground="#8FB6FF" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="8,2" CornerRadius="10" Background="#262B35" VerticalAlignment="Top">
                      <TextBlock Text="{Binding State}" FontSize="11" Foreground="#F2E9D8" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Build">
        <StackPanel Margin="10" Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
          <TextBlock Text="Build the GamePack for the selected game" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Text="{Binding SelectedSummary}" TextWrapping="Wrap" FontSize="12" Foreground="#9BA3B4" />
          <ComboBox ItemsSource="{Binding BuildModes}" SelectedItem="{Binding BuildModeText}" Width="520" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="macOS build host:" VerticalAlignment="Center" />
            <TextBox Text="{Binding BuildHost}" PlaceholderText="host profile name from builder-windows/zkb (e.g. office)" Width="320" />
          </StackPanel>
          <TextBlock Text="Real AOT code needs an Apple-compatible Mach-O toolchain. The supported path is the existing builder-windows Build Agent on a Mac you control (this PC never needs Xcode). The experimental local build (Settings, feature flag) compiles the same GamePack on this PC with 3dsrecomp + open-source LLVM/Clang + ld64.lld, no Apple SDK and no Mac; it is gated until the runtime end-to-end check is signed off. The built GamePack.dylib stays inside the signed app IPA (not Documents). See docs/windows-build.md."
                     TextWrapping="Wrap" FontSize="12" Foreground="#8A93A6" MaxWidth="880" />
          <Border Padding="10" CornerRadius="6" Background="#241E14">
            <TextBlock Text="Preview builds write labelled placeholders. They let you test the whole flow, but the phone cannot run them — only the macOS Build Agent produces installable packs."
                       TextWrapping="Wrap" FontSize="12" Foreground="#E8C98A" />
          </Border>
          <Button Content="Build selected game" Command="{Binding BuildSelectedCommand}" Padding="18,10" HorizontalAlignment="Left" />
        </StackPanel>
      </TabItem>

      <TabItem Header="App &amp; Device">
        <Grid ColumnDefinitions="*,14,*" Margin="10">
          <StackPanel Spacing="10">
            <TextBlock Text="Phone" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="{Binding DeviceStatus}" TextWrapping="Wrap" FontSize="12" Foreground="#9BA3B4" />
            <Button Content="Refresh devices" Command="{Binding RefreshDevicesCommand}" />
            <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Height="180" Background="#181B21">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding Udid}" FontSize="12" />
                    <TextBlock Text="{Binding Connection}" FontSize="11" Foreground="#9BA3B4" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Padding="10" CornerRadius="6" Background="#1E222A">
              <StackPanel Spacing="6">
                <TextBlock Text="Prerequisites" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="Windows 10/11 + Apple Devices (or iTunes) for the USB device service." FontSize="12" Foreground="#9BA3B4" TextWrapping="Wrap" />
                <TextBlock Text="Enable Developer Mode on the iPhone/iPad and tap Trust on this computer." FontSize="12" Foreground="#9BA3B4" TextWrapping="Wrap" />
                <TextBlock Text="The phone stays unlocked while installing and pushing." FontSize="12" Foreground="#9BA3B4" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="10">
            <TextBlock Text="App (shell template + game packs)" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="Every built game's GamePack.dylib + GameCatalog.json are injected into the ROM-free shell template IPA, then the whole IPA is signed and installed. Adding/removing a game rebuilds and reinstalls the app; pushed ROM data stays."
                       TextWrapping="Wrap" FontSize="11" Foreground="#8A93A6" />
            <TextBlock Text="{Binding ShellStatus}" TextWrapping="Wrap" FontSize="12" Foreground="#9BA3B4" />
            <TextBlock Text="{Binding ShellBundleId, StringFormat='Bundle id: {0}'}" FontSize="12" Foreground="#C8CFDB" />
            <Button Content="Open Impactor and sign in (Apple ID)" Command="{Binding OpenImpactorCommand}" Padding="0,10" />
            <Button Content="Install / update app (signs whole IPA)" Command="{Binding InstallShellCommand}" Padding="0,10" />
            <Border Padding="10" CornerRadius="6" Background="#241E14">
              <TextBlock Text="The bundled Impactor v2.7.2 and plumesign are the official, unmodified release binaries (SHA-256 pinned). They sign the whole IPA, including the nested Frameworks dylibs. Your Apple ID and password are entered only in Impactor."
                         TextWrapping="Wrap" FontSize="12" Foreground="#E8C98A" />
            </Border>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Push to Phone">
        <StackPanel Margin="10" Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
          <TextBlock Text="Push the selected game's ROM data" FontWeight="SemiBold" FontSize="15" />
          <TextBlock Text="{Binding SelectedSummary}" TextWrapping="Wrap" FontSize="12" Foreground="#9BA3B4" />
          <TextBlock Text="{Binding PushStatus}" TextWrapping="Wrap" FontSize="12" Foreground="#9AA7C7" />
          <TextBlock Text="Only GameRom.cci and GameInfo.json go to Documents/Games/&lt;TITLEID&gt;/ (GameInfo last). The GamePack stays inside the signed app; sizes are verified on the phone after the transfer. Pushed ROM data survives app reinstalls."
                     TextWrapping="Wrap" FontSize="12" Foreground="#8A93A6" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Push selected game ROM" Command="{Binding PushSelectedCommand}" Padding="18,10" />
            <Button Content="Verify ROM data on phone" Command="{Binding VerifyPushCommand}" Padding="18,10" />
          </StackPanel>
          <Border Padding="10" CornerRadius="6" Background="#1E222A">
            <TextBlock Text="Resume: re-running the push skips files whose size already matches on the phone. A 90-second stall aborts with a retry hint from the device bridge. The shell shows 'Data missing' for a game until its ROM push verifies."
                       TextWrapping="Wrap" FontSize="12" Foreground="#9BA3B4" />
          </Border>
        </StackPanel>
      </TabItem>

      <TabItem Header="Settings &amp; Diagnostics">
        <Grid ColumnDefinitions="*,14,*" Margin="10">
          <ScrollViewer>
            <StackPanel Spacing="8">
              <TextBlock Text="Tools" FontWeight="SemiBold" FontSize="15" />
              <TextBlock Text="Leave empty to use the bundled layout (Bin/ and ThirdParty/Impactor) or PATH." FontSize="12" Foreground="#9BA3B4" TextWrapping="Wrap" />
              <TextBlock Text="3ds2apple-pack.exe" FontSize="12" Foreground="#9BA3B4" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding PackPathSetting}" />
                <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="BrowsePackClicked" />
              </Grid>
              <TextBlock Text="devpush.exe (device bridge)" FontSize="12" Foreground="#9BA3B4" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding DevPushPathSetting}" />
                <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="BrowseDevPushClicked" />
              </Grid>
              <TextBlock Text="builder-windows.exe (macOS Build Agent CLI)" FontSize="12" Foreground="#9BA3B4" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding BuilderPathSetting}" />
                <Button Grid.Column="1" Content="Browse…" Margin="6,0,0,0" Click="BrowseBuilderClicked" />
              </Grid>
              <TextBlock Text="Experimental local build (3dsrecomp + open-source LLVM/LLD on this PC — no macOS host, no Apple SDK)"
                         FontWeight="SemiBold" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap" />
              <CheckBox Content="Enable the experimental local build (feature flag; see docs/windows-build.md)"
                        IsChecked="{Binding LocalBuildEnabled}" />
              <TextBlock Text="3dsrecomp.exe (ROM → generated C; build it from the pinned upstream revision)" FontSize="12" Foreground="#9BA3B4" />
              <TextBox Text="{Binding RecompPathSetting}" PlaceholderText="C:\path\to\3dsrecomp.exe" />
              <TextBlock Text="LLVM bin folder (clang.exe, llvm-ar.exe, ld64.lld.exe from the official LLVM release)" FontSize="12" Foreground="#9BA3B4" />
              <TextBox Text="{Binding LlvmDirSetting}" PlaceholderText="C:\Program Files\LLVM\bin" />
              <TextBlock Text="devpush mock directory (optional; lets you test the flow without a phone)" FontSize="12" Foreground="#9BA3B4" />
              <TextBox Text="{Binding MockDirectory}" />
              <TextBlock Text="Shell bundle id override (use when Apple answers 9401 for the bundled id)" FontSize="12" Foreground="#9BA3B4" />
              <TextBox Text="{Binding BundleIdOverride}" PlaceholderText="com.yourname.3ds2apple.shell" />
              <TextBlock Text="Workspace (packages, app IPAs, staging, logs — never inside the git repo)" FontSize="12" Foreground="#9BA3B4" />
              <SelectableTextBlock Text="{Binding WorkspaceRoot}" FontSize="12" Foreground="#C8CFDB" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Padding="14,8" />
                <Button Content="Open workspace folder" Command="{Binding OpenWorkspaceCommand}" />
                <Button Content="Run self-test" Command="{Binding RunSelfTestCommand}" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Column="2" Spacing="8">
            <TextBlock Text="Readiness" FontWeight="SemiBold" FontSize="15" />
            <ItemsControl ItemsSource="{Binding Tools}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Padding="8" Margin="0,0,0,6" CornerRadius="6" Background="#1E222A">
                    <StackPanel Spacing="2">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="11" Foreground="#F2E9D8" />
                      </Grid>
                      <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#9BA3B4" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Logs" FontWeight="SemiBold" FontSize="15" />
            <TextBlock Text="{Binding WorkspaceRoot, StringFormat='Daily log lives in {0}/logs'}" FontSize="11" Foreground="#9BA3B4" TextWrapping="Wrap" />
            <TextBlock Text="Legal: only use ROMs you own. The launcher never bundles or downloads games, keys or system files. The app IPA is ROM-free; game data is pushed separately. Do not redistribute signed apps or ROM-bundled packages."
                       TextWrapping="Wrap" FontSize="11" Foreground="#8A93A6" />
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
